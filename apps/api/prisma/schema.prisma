generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── Tenancy ─────────────────────────────────────────────────────────────────
// Every center-owned record carries `centerId`. Services resolve the center from the
// caller's validated membership (see src/tenancy), never from request input.

enum CenterStatus {
  ACTIVE
  SUSPENDED
}

model Center {
  id        String       @id @default(uuid()) @db.Uuid
  /// Human-readable, immutable identifier, e.g. SBTC-4821
  code      String       @unique
  name      String
  phone     String
  email     String?
  address   String
  district  String?
  country   String       @default("Bangladesh")
  timezone  String       @default("Asia/Dhaka")
  currency  String       @default("BDT")
  logoUrl   String?
  website   String?
  status    CenterStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  memberships          CenterMembership[]
  invitations          Invitation[]
  auditLogs            AuditLog[]
  sessions             Session[]
  therapyTypes         TherapyType[]
  workingHours         CenterWorkingHour[]
  closures             CenterClosure[]
  schedulingSettings   CenterSchedulingSettings?
  generalSettings      CenterGeneralSettings?
  therapists           Therapist[]
  therapistHours       TherapistAvailability[]
  therapistTimeOff     TherapistTimeOff[]
  sequences            CenterSequence[]
  patients             Patient[]
  guardians            Guardian[]
  patientConsents      PatientConsent[]
  appointmentSeries    AppointmentSeries[]
  appointments         Appointment[]
  appointmentHistory   AppointmentHistory[]
  assessmentTemplates  AssessmentTemplate[]
  templateVersions     AssessmentTemplateVersion[]
  assessments          Assessment[]
  assessmentAmendments AssessmentAmendment[]
  goalCategories       TherapyGoalCategory[]
  therapyPlans         TherapyPlan[]
  therapyPlanGoals     TherapyPlanGoal[]
  goalProgress         TherapyGoalProgress[]
  planReviews          TherapyPlanReview[]
  reviewAmendments     TherapyPlanReviewAmendment[]
  planRevisions        TherapyPlanRevision[]
  therapyPackages      TherapyPackage[]
  packageEnrollments   PackageEnrollment[]
  packageLedger        PackageSessionLedger[]
  packageReservations  PackageSessionReservation[]
}

/// Per-center counters for human-readable numbers such as patient codes. A number is
/// taken by incrementing the row inside the transaction that uses it, so the row lock
/// serializes concurrent writers and a rolled-back write gives its number back.
model CenterSequence {
  centerId  String @db.Uuid
  /// What is being numbered, e.g. "patient"
  name      String
  lastValue Int    @default(0)

  center Center @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@id([centerId, name])
}

// ── Identity ────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

/// A global identity. What a user may do is decided per center by CenterMembership.
model User {
  id              String     @id @default(uuid()) @db.Uuid
  fullName        String
  /// Stored trimmed and lower-cased
  email           String     @unique
  /// Stored as 11 local digits, e.g. 01712345678
  mobile          String?
  passwordHash    String
  status          UserStatus @default(ACTIVE)
  /// Sign-in name for platform administrators (/admin/login). Stored lower-cased.
  username        String?    @unique
  /// Platform operators (super admins) see and register every center
  isPlatformAdmin Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  memberships               CenterMembership[]
  sessions                  Session[]
  passwordResetTokens       PasswordResetToken[]
  invitationsSent           Invitation[]                 @relation("InvitedBy")
  auditLogs                 AuditLog[]
  patientsRegistered        Patient[]                    @relation("PatientRegisteredBy")
  consentsRecorded          PatientConsent[]             @relation("ConsentRecordedBy")
  appointmentsBooked        Appointment[]                @relation("AppointmentCreatedBy")
  appointmentsUpdated       Appointment[]                @relation("AppointmentUpdatedBy")
  appointmentsCancelled     Appointment[]                @relation("AppointmentCancelledBy")
  seriesBooked              AppointmentSeries[]          @relation("SeriesCreatedBy")
  appointmentChanges        AppointmentHistory[]         @relation("AppointmentChangedBy")
  templatesCreated          AssessmentTemplate[]         @relation("TemplateCreatedBy")
  templateVersionsMade      AssessmentTemplateVersion[]  @relation("TemplateVersionCreatedBy")
  templateVersionsPublished AssessmentTemplateVersion[]  @relation("TemplateVersionPublishedBy")
  assessmentsCreated        Assessment[]                 @relation("AssessmentCreatedBy")
  assessmentsUpdated        Assessment[]                 @relation("AssessmentUpdatedBy")
  assessmentsCompleted      Assessment[]                 @relation("AssessmentCompletedBy")
  assessmentAmendments      AssessmentAmendment[]        @relation("AssessmentAmendedBy")
  plansCreated              TherapyPlan[]                @relation("PlanCreatedBy")
  plansUpdated              TherapyPlan[]                @relation("PlanUpdatedBy")
  plansActivated            TherapyPlan[]                @relation("PlanActivatedBy")
  plansCompleted            TherapyPlan[]                @relation("PlanCompletedBy")
  plansDiscontinued         TherapyPlan[]                @relation("PlanDiscontinuedBy")
  goalsCreated              TherapyPlanGoal[]            @relation("GoalCreatedBy")
  goalStatusChanges         TherapyPlanGoal[]            @relation("GoalStatusChangedBy")
  progressRecorded          TherapyGoalProgress[]        @relation("ProgressRecordedBy")
  planReviews               TherapyPlanReview[]          @relation("PlanReviewedBy")
  reviewAmendments          TherapyPlanReviewAmendment[] @relation("ReviewAmendedBy")
  planRevisions             TherapyPlanRevision[]        @relation("PlanRevisedBy")
  packagesCreated           TherapyPackage[]             @relation("PackageCreatedBy")
  packagesUpdated           TherapyPackage[]             @relation("PackageUpdatedBy")
  enrollmentsCreated        PackageEnrollment[]          @relation("EnrollmentCreatedBy")
  enrollmentsCancelled      PackageEnrollment[]          @relation("EnrollmentCancelledBy")
  packageMovements          PackageSessionLedger[]       @relation("LedgerCreatedBy")
  reservationsMade          PackageSessionReservation[]  @relation("ReservationCreatedBy")
  reservationsReleased      PackageSessionReservation[]  @relation("ReservationReleasedBy")
}

// ── Access ──────────────────────────────────────────────────────────────────

/// Fixed roles; their permissions are mapped in src/auth/permissions.ts.
enum Role {
  CENTER_ADMIN
  MANAGER
  RECEPTIONIST
  THERAPIST
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

model CenterMembership {
  id        String           @id @default(uuid()) @db.Uuid
  centerId  String           @db.Uuid
  userId    String           @db.Uuid
  role      Role
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  center    Center     @relation(fields: [centerId], references: [id], onDelete: Restrict)
  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// The therapist profile this staff member signs in as, if any
  therapist Therapist?

  @@unique([centerId, userId])
  @@index([userId])
  @@index([centerId, status, role])
}

/// Server-side browser session. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  tokenHash      String    @unique
  /// The center this session is working in; re-validated against memberships on every request
  activeCenterId String?   @db.Uuid
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime  @default(now())
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeCenter Center? @relation(fields: [activeCenterId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Pending access to a center. A membership is only created when the invitee accepts.
model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  centerId       String    @db.Uuid
  /// Stored trimmed and lower-cased
  email          String
  fullName       String
  mobile         String?
  role           Role
  tokenHash      String    @unique
  invitedById    String    @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedUserId String?   @db.Uuid
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  center    Center @relation(fields: [centerId], references: [id], onDelete: Restrict)
  invitedBy User   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([centerId, email])
}

// ── Audit ───────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  centerId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  /// Dotted action name, e.g. staff.role_changed
  action      String
  entityType  String
  entityId    String?
  /// Non-sensitive details such as before/after values. Never credentials or tokens.
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  center Center? @relation(fields: [centerId], references: [id], onDelete: Restrict)
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([centerId, createdAt])
}

// ── Therapy services ────────────────────────────────────────────────────────
// Therapy types are plain per-center records, never hard-coded disciplines. Other
// records must reference them by `id` (never by name or code) with onDelete: Restrict,
// so a type in use can be deactivated but not deleted.

model TherapyType {
  id                     String   @id @default(uuid()) @db.Uuid
  centerId               String   @db.Uuid
  name                   String
  /// Short code shown on calendars and receipts, e.g. OT. Stored upper-cased.
  code                   String
  description            String?
  /// The default duration option; kept in step with it by TherapyTypesService
  defaultDurationMinutes Int
  /// Hex colour, e.g. #0d9488
  color                  String?
  /// Inactive types can't be chosen for new records but stay on existing ones
  isActive               Boolean  @default(true)
  displayOrder           Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  center              Center                         @relation(fields: [centerId], references: [id], onDelete: Restrict)
  durationOptions     TherapyDurationOption[]
  specializations     TherapistSpecialization[]
  patientInterests    PatientTherapyInterest[]
  appointments        Appointment[]
  series              AppointmentSeries[]
  assessmentTemplates AssessmentTemplate[]
  assessments         Assessment[]
  recommendations     AssessmentRecommendation[]
  goalCategories      TherapyGoalCategory[]
  therapyPlans        TherapyPlan[]
  packages            PackageEligibleTherapyType[]
  enrollments         PackageEnrollmentTherapyType[]

  @@unique([centerId, code])
  @@unique([centerId, name])
  @@index([centerId, isActive, displayOrder])
}

/// Session lengths a therapy type can be booked for. The option whose duration equals
/// TherapyType.defaultDurationMinutes is the default, so there is exactly one.
/// Bookings store their own duration, so editing an option never changes them.
model TherapyDurationOption {
  id              String   @id @default(uuid()) @db.Uuid
  therapyTypeId   String   @db.Uuid
  durationMinutes Int
  /// Optional name, e.g. "Extended session"
  label           String?
  isActive        Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  therapyType TherapyType @relation(fields: [therapyTypeId], references: [id], onDelete: Cascade)

  @@unique([therapyTypeId, durationMinutes])
}

// ── Center schedule ─────────────────────────────────────────────────────────
// Times are minutes since midnight in the center's time zone (Center.timezone).

/// One opening interval on a weekday. A day with no rows is closed.
model CenterWorkingHour {
  id           String   @id @default(uuid()) @db.Uuid
  centerId     String   @db.Uuid
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek    Int
  startMinutes Int
  endMinutes   Int
  createdAt    DateTime @default(now())

  center Center @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@unique([centerId, dayOfWeek, startMinutes])
}

/// A holiday or other closure. Bookings aren't changed here; scheduling reads these.
model CenterClosure {
  id           String   @id @default(uuid()) @db.Uuid
  centerId     String   @db.Uuid
  title        String
  /// Inclusive dates in the center's time zone
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  reason       String?
  allDay       Boolean  @default(true)
  /// Only for single-day, part-day closures (allDay = false)
  startMinutes Int?
  endMinutes   Int?
  /// Inactive closures are kept for reference but ignored by scheduling
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  center Center @relation(fields: [centerId], references: [id], onDelete: Restrict)

  @@index([centerId, endDate])
}

// ── Center settings ─────────────────────────────────────────────────────────
// One row per center, created on first use. Defaults live here and nowhere else.

/// Booking policies. The booking engine applies them; nothing here books anything.
model CenterSchedulingSettings {
  centerId                    String   @id @db.Uuid
  slotIntervalMinutes         Int      @default(15)
  bookingBufferMinutes        Int      @default(0)
  /// Whether a booking may use a length other than the therapy type's duration options
  allowCustomDuration         Boolean  @default(false)
  allowBookingOnClosedDays    Boolean  @default(false)
  advanceBookingLimitDays     Int      @default(60)
  minimumBookingNoticeMinutes Int      @default(0)
  /// Policy only: scheduling must still detect collisions and apply this rule
  allowDoubleBooking          Boolean  @default(false)
  allowPastDateBooking        Boolean  @default(false)
  cancellationCutoffMinutes   Int      @default(0)
  updatedAt                   DateTime @updatedAt

  center Center @relation(fields: [centerId], references: [id], onDelete: Restrict)
}

/// How a new booking's duration is preselected.
enum DefaultDurationBehavior {
  /// The therapy type's default duration
  THERAPY_TYPE_DEFAULT
  /// The patient's last booked duration for that therapy, else the therapy default
  PREVIOUS_SESSION
  /// Nothing preselected; staff choose every time
  ASK_EACH_TIME
}

/// Patient lifecycle. Registration starts at NEW or ACTIVE (CenterGeneralSettings);
/// INACTIVE keeps the record and its history but takes the patient out of day-to-day work.
enum PatientStatus {
  NEW
  ACTIVE
  INACTIVE
}

enum DateDisplayFormat {
  /// 14 Oct 2026
  D_MMM_YYYY
  /// 14/10/2026
  DD_MM_YYYY
  /// 10/14/2026
  MM_DD_YYYY
  /// 2026-10-14
  YYYY_MM_DD
}

enum TimeDisplayFormat {
  H12
  H24
}

model CenterGeneralSettings {
  centerId                String                  @id @db.Uuid
  defaultDurationBehavior DefaultDurationBehavior @default(THERAPY_TYPE_DEFAULT)
  autoGeneratePatientCode Boolean                 @default(true)
  /// e.g. "P-" gives P-0001. Null: codes are numbers only.
  patientCodePrefix       String?
  defaultPatientStatus    PatientStatus           @default(NEW)
  dateFormat              DateDisplayFormat       @default(D_MMM_YYYY)
  timeFormat              TimeDisplayFormat       @default(H12)
  /// First day of the week on calendars: 0 = Sunday, 1 = Monday, 6 = Saturday
  weekStartsOn            Int                     @default(6)
  updatedAt               DateTime                @updatedAt

  center Center @relation(fields: [centerId], references: [id], onDelete: Restrict)
}

// ── Therapists ──────────────────────────────────────────────────────────────
// A therapist is a center-scoped professional profile: the operational record that
// specializations, availability, time off and (later) appointments and notes point at.
// It needn't have a login; a staff membership of the same center can be linked to it.
// Times of day are minutes since midnight in the center's time zone, as for
// CenterWorkingHour.

enum TherapistStatus {
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  VISITING
  CONTRACTUAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

/// Profiles are never hard-deleted (deletedAt), so later records can always refer to them.
model Therapist {
  id                 String          @id @default(uuid()) @db.Uuid
  centerId           String          @db.Uuid
  /// Generated per center, e.g. TH-0007. Never reused, even after deletion.
  code               String
  fullName           String
  /// BD mobiles as 11 local digits (01712345678); other countries in +E.164 form
  mobile             String
  /// Stored trimmed and lower-cased
  email              String?
  gender             Gender?
  photoUrl           String?
  designation        String?
  qualifications     String?
  registrationNumber String?
  yearsOfExperience  Int?
  joiningDate        DateTime?       @db.Date
  employmentType     EmploymentType?
  notes              String?
  /// Inactive therapists keep their history but can't be booked. Not the same as
  /// their staff membership's status, which controls sign-in.
  status             TherapistStatus @default(ACTIVE)
  /// Optional link to a staff membership in the same center (checked by the API)
  membershipId       String?         @unique @db.Uuid
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  center          Center                    @relation(fields: [centerId], references: [id], onDelete: Restrict)
  membership      CenterMembership?         @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  specializations TherapistSpecialization[]
  availability    TherapistAvailability[]
  timeOff         TherapistTimeOff[]
  appointments    Appointment[]
  series          AppointmentSeries[]
  assessments     Assessment[]
  therapyPlans    TherapyPlan[]
  planReviews     TherapyPlanReview[]

  @@unique([centerId, code])
  @@index([centerId, deletedAt, status])
  @@index([centerId, fullName])
}

/// A therapy type the therapist provides. At most one per therapist is primary (the API
/// keeps it so). Appointments and notes will store the therapy type themselves, so
/// removing a specialization never changes past records.
model TherapistSpecialization {
  id            String   @id @default(uuid()) @db.Uuid
  therapistId   String   @db.Uuid
  therapyTypeId String   @db.Uuid
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  therapist   Therapist   @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  therapyType TherapyType @relation(fields: [therapyTypeId], references: [id], onDelete: Restrict)

  @@unique([therapistId, therapyTypeId])
  @@index([therapyTypeId])
}

/// One recurring weekly interval. Inactive rows are a day switched off in the editor,
/// kept so switching it back on restores its hours; only active rows count.
model TherapistAvailability {
  id           String   @id @default(uuid()) @db.Uuid
  centerId     String   @db.Uuid
  therapistId  String   @db.Uuid
  /// 0 = Sunday … 6 = Saturday
  dayOfWeek    Int
  startMinutes Int
  endMinutes   Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  center    Center    @relation(fields: [centerId], references: [id], onDelete: Restrict)
  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Restrict)

  @@unique([therapistId, dayOfWeek, startMinutes])
  @@index([centerId, dayOfWeek])
}

enum TimeOffReason {
  PERSONAL
  SICK
  TRAINING
  VACATION
  EMERGENCY
  SCHEDULE_CHANGE
  OTHER
}

/// A period the therapist is away, overriding their weekly availability. Bookings in the
/// period are never changed here; scheduling reads these to stop new ones.
model TherapistTimeOff {
  id          String         @id @default(uuid()) @db.Uuid
  centerId    String         @db.Uuid
  therapistId String         @db.Uuid
  /// Half-open [startAt, endAt). All-day entries run from midnight to midnight in the
  /// center's time zone.
  startAt     DateTime
  endAt       DateTime
  isAllDay    Boolean        @default(false)
  reason      TimeOffReason?
  note        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  center    Center    @relation(fields: [centerId], references: [id], onDelete: Restrict)
  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Restrict)

  @@index([therapistId, endAt])
  @@index([centerId, startAt])
}

// ── Patients ────────────────────────────────────────────────────────────────
// A patient is the center-scoped record that assessments, bookings, plans, notes,
// packages and invoices will point at, so it's only ever soft-deleted (deletedAt).
// Guardians are people in their own right, linked to patients through PatientGuardian,
// which holds the relationship: the same person can be one child's father and another's
// uncle. Patients who manage their own care keep their contact details on Patient and
// need no guardian at all.

enum GuardianContactType {
  /// Parent or legal guardian
  GUARDIAN
  /// Another authorized caregiver or contact
  CAREGIVER
}

/// How a guardian is related to one patient. OTHER comes with customRelationship.
enum GuardianRelationship {
  FATHER
  MOTHER
  LEGAL_GUARDIAN
  GRANDPARENT
  SIBLING
  SPOUSE
  OTHER
}

/// How the patient heard of the center. OTHER comes with referralOther.
enum ReferralSource {
  DOCTOR
  SCHOOL
  FRIEND_FAMILY
  SOCIAL_MEDIA
  EXISTING_PATIENT
  WALK_IN
  OTHER
}

model Patient {
  id                   String          @id @default(uuid()) @db.Uuid
  centerId             String          @db.Uuid
  /// Unique per center and never reused, e.g. P-0042. Generated from CenterSequence
  /// unless the center types its own codes (CenterGeneralSettings).
  code                 String
  fullName             String
  dateOfBirth          DateTime?       @db.Date
  /// Only when the date of birth isn't known: the stated age in whole months, as of
  /// approxAgeAsOf. Never stored together with dateOfBirth; ages are computed on read.
  approxAgeMonths      Int?
  approxAgeAsOf        DateTime?       @db.Date
  gender               Gender?
  photoUrl             String?
  primaryConcern       String?
  /// The patient's own contact details, for adults who manage their own care. Mobiles
  /// as for Therapist.mobile.
  mobile               String?
  secondaryMobile      String?
  /// Stored trimmed and lower-cased
  email                String?
  address              String?
  /// A number to call in an emergency, whoever the contacts are
  emergencyPhone       String?
  /// The patient is their own primary contact. Otherwise exactly one guardian link is
  /// primary; the API keeps it so.
  primaryContactIsSelf Boolean         @default(false)
  status               PatientStatus   @default(NEW)
  referralSource       ReferralSource?
  referralOther        String?
  internalNotes        String?
  registeredAt         DateTime        @default(now())
  registeredById       String          @db.Uuid
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?

  center           Center                   @relation(fields: [centerId], references: [id], onDelete: Restrict)
  registeredBy     User                     @relation("PatientRegisteredBy", fields: [registeredById], references: [id], onDelete: Restrict)
  guardians        PatientGuardian[]
  therapyInterests PatientTherapyInterest[]
  consents         PatientConsent[]
  appointments     Appointment[]
  series           AppointmentSeries[]
  assessments      Assessment[]
  therapyPlans     TherapyPlan[]
  packages         PackageEnrollment[]

  @@unique([centerId, code])
  @@index([centerId, deletedAt, status])
  @@index([centerId, registeredAt])
  @@index([centerId, fullName])
  @@index([centerId, mobile])
}

/// A parent, guardian or caregiver. Center-scoped, and never merged or deleted by the
/// API: matching mobiles only suggest the same person, staff decide. Mobile numbers
/// aren't unique, since families share phones.
model Guardian {
  id              String   @id @default(uuid()) @db.Uuid
  centerId        String   @db.Uuid
  fullName        String
  mobile          String
  secondaryMobile String?
  /// Stored trimmed and lower-cased
  email           String?
  address         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  center   Center            @relation(fields: [centerId], references: [id], onDelete: Restrict)
  patients PatientGuardian[]
  consents PatientConsent[]

  @@index([centerId, mobile])
  @@index([centerId, secondaryMobile])
  @@index([centerId, fullName])
}

/// One guardian's relationship to one patient. Both must belong to the same center
/// (checked by the API). Unlinking deletes this row only, never the guardian.
model PatientGuardian {
  id                 String               @id @default(uuid()) @db.Uuid
  patientId          String               @db.Uuid
  guardianId         String               @db.Uuid
  contactType        GuardianContactType  @default(GUARDIAN)
  relationship       GuardianRelationship
  customRelationship String?
  isPrimary          Boolean              @default(false)
  isEmergencyContact Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  patient  Patient  @relation(fields: [patientId], references: [id], onDelete: Restrict)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Restrict)

  @@unique([patientId, guardianId])
  @@index([guardianId])
}

/// A therapy the patient is interested in. Inactive therapy types stay on the patient.
model PatientTherapyInterest {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @db.Uuid
  therapyTypeId String   @db.Uuid
  createdAt     DateTime @default(now())

  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  therapyType TherapyType @relation(fields: [therapyTypeId], references: [id], onDelete: Restrict)

  @@unique([patientId, therapyTypeId])
  @@index([therapyTypeId])
}

enum ConsentPurpose {
  /// Assessment and therapy
  TREATMENT
  /// Keeping and using personal and health information
  DATA_PROCESSING
  /// Photos and videos for therapy records
  MEDIA
}

enum ConsentGivenBy {
  SELF
  GUARDIAN
}

/// Consent history, append-only: a withdrawal is a new row with granted = false, and the
/// latest row per purpose is the current state. Recording consent here doesn't by itself
/// meet every legal requirement; centers keep their signed forms.
model PatientConsent {
  id           String         @id @default(uuid()) @db.Uuid
  centerId     String         @db.Uuid
  patientId    String         @db.Uuid
  purpose      ConsentPurpose
  /// The form or policy version agreed to, e.g. "Registration form v2"
  version      String?
  granted      Boolean
  givenBy      ConsentGivenBy
  /// Set when givenBy is GUARDIAN
  guardianId   String?        @db.Uuid
  /// Who gave it, as named at the time
  givenByName  String
  note         String?
  recordedById String         @db.Uuid
  recordedAt   DateTime       @default(now())

  center     Center    @relation(fields: [centerId], references: [id], onDelete: Restrict)
  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Restrict)
  guardian   Guardian? @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  recordedBy User      @relation("ConsentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([patientId, purpose, recordedAt])
}

// ── Appointments ────────────────────────────────────────────────────────────
// A booked service: who, with whom, which therapy and when. Not a clinical record, an
// attendance record, a package deduction or an invoice; those modules will point at
// appointments rather than live in them. Instants are UTC; dates and times shown to
// staff are the center's wall clock (Center.timezone). Bookable time is computed on
// demand from schedules and existing appointments, never stored as slots.
//
// Overlaps are prevented by two exclusion constraints added in raw SQL (see the
// appointments migration): one per therapist, covering [startAt, endAt + bufferMinutes),
// and one per patient, covering [startAt, endAt). Both apply to SCHEDULED, CONFIRMED and
// COMPLETED rows that aren't allowOverlap, so concurrent bookings can't both succeed.

/// Workflow category, not a discipline: the service itself is the TherapyType.
enum AppointmentType {
  ASSESSMENT
  THERAPY_SESSION
}

/// The booking's lifecycle only. COMPLETED doesn't mean a note was written or a session
/// paid for; attendance, notes and payment are tracked by their own modules.
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CancellationReason {
  PATIENT_REQUEST
  THERAPIST_UNAVAILABLE
  CENTER_CLOSURE
  PERSONAL_REASON
  OTHER
}

enum AppointmentSeriesStatus {
  ACTIVE
  /// Its remaining occurrences were cancelled together
  CANCELLED
}

enum AppointmentHistoryAction {
  CREATED
  UPDATED
  RESCHEDULED
  STATUS_CHANGED
  CANCELLED
}

/// How a recurring booking was asked for. Its occurrences are ordinary Appointment rows
/// created up front (a bounded number), so each can be moved or cancelled on its own;
/// the series keeps the rule so later series-wide actions know what was intended.
model AppointmentSeries {
  id                 String                  @id @default(uuid()) @db.Uuid
  centerId           String                  @db.Uuid
  patientId          String                  @db.Uuid
  therapistId        String                  @db.Uuid
  therapyTypeId      String                  @db.Uuid
  type               AppointmentType
  /// { frequency, interval, daysOfWeek, startTime, count | until }, as booked (recurrence.ts)
  recurrenceRule     Json
  /// The center's time zone when booked: the rule's dates and times are wall-clock there
  timezone           String
  durationMinutes    Int
  startsOn           DateTime                @db.Date
  /// The rule's end date, or the date of its last occurrence when it ends after a count
  endsOn             DateTime                @db.Date
  status             AppointmentSeriesStatus @default(ACTIVE)
  /// Dates the rule produced that staff chose to skip because of conflicts, with reasons
  skippedOccurrences Json?
  createdById        String                  @db.Uuid
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  center       Center        @relation(fields: [centerId], references: [id], onDelete: Restrict)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Restrict)
  therapist    Therapist     @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  therapyType  TherapyType   @relation(fields: [therapyTypeId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("SeriesCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@index([centerId, patientId])
  @@index([therapistId])
}

/// Never deleted: cancelling sets status CANCELLED and keeps the row and its history.
model Appointment {
  id                  String              @id @default(uuid()) @db.Uuid
  centerId            String              @db.Uuid
  /// Set when created by a recurring booking; stays set if this occurrence is moved
  seriesId            String?             @db.Uuid
  patientId           String              @db.Uuid
  therapistId         String              @db.Uuid
  therapyTypeId       String              @db.Uuid
  type                AppointmentType
  /// Half-open [startAt, endAt), UTC; endAt = startAt + durationMinutes
  startAt             DateTime
  endAt               DateTime
  /// The booked length, kept even if the therapy type's duration options change later
  durationMinutes     Int
  /// CenterSchedulingSettings.bookingBufferMinutes when booked: the therapist is kept
  /// free for this long after endAt
  bufferMinutes       Int                 @default(0)
  /// Booked over a clash on purpose, because the center allows double booking. Such rows
  /// are exempt from the overlap constraints; nothing else is.
  allowOverlap        Boolean             @default(false)
  status              AppointmentStatus   @default(SCHEDULED)
  internalNotes       String?
  createdById         String              @db.Uuid
  updatedById         String?             @db.Uuid
  cancelledAt         DateTime?
  cancelledById       String?             @db.Uuid
  cancellationReason  CancellationReason?
  cancellationNote    String?
  /// Cancelled with less notice than the center's cancellation cutoff
  lateCancellation    Boolean             @default(false)
  /// The package enrollment this booking was assigned to, if any. Whether it still
  /// holds or used a session is its PackageSessionReservation's status.
  packageEnrollmentId String?             @db.Uuid
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  center              Center                      @relation(fields: [centerId], references: [id], onDelete: Restrict)
  series              AppointmentSeries?          @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  packageEnrollment   PackageEnrollment?          @relation(fields: [packageEnrollmentId], references: [id], onDelete: Restrict)
  packageReservations PackageSessionReservation[]
  packageMovements    PackageSessionLedger[]
  patient             Patient                     @relation(fields: [patientId], references: [id], onDelete: Restrict)
  therapist           Therapist                   @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  therapyType         TherapyType                 @relation(fields: [therapyTypeId], references: [id], onDelete: Restrict)
  createdBy           User                        @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy           User?                       @relation("AppointmentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  cancelledBy         User?                       @relation("AppointmentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  history             AppointmentHistory[]
  /// The assessment recorded for this booking, if any (at most one)
  assessment          Assessment?

  @@index([centerId, startAt])
  @@index([centerId, status, startAt])
  @@index([therapistId, startAt])
  @@index([patientId, startAt])
  @@index([seriesId, startAt])
  @@index([packageEnrollmentId])
}

/// Append-only log of what happened to an appointment and who did it. Values hold
/// times, people's IDs, statuses and changed field names, never note text.
model AppointmentHistory {
  id             String                   @id @default(uuid()) @db.Uuid
  centerId       String                   @db.Uuid
  appointmentId  String                   @db.Uuid
  action         AppointmentHistoryAction
  previousValues Json?
  newValues      Json?
  reason         String?
  performedById  String                   @db.Uuid
  createdAt      DateTime                 @default(now())

  center      Center      @relation(fields: [centerId], references: [id], onDelete: Restrict)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  performedBy User        @relation("AppointmentChangedBy", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([appointmentId, createdAt])
}

// ── Assessments ─────────────────────────────────────────────────────────────
// Clinical assessment records, built from center-defined templates rather than
// hard-coded discipline forms. A template's form lives in versions: a version is
// edited while DRAFT and frozen once published (a trigger in the assessments migration
// refuses later changes to its definition), and every assessment points at the exact
// version it was filled in with, so editing a template never changes past records.
//
// Definitions and answers are JSON validated by src/assessments/engine.ts, the one
// schema both are checked against. The clinical summary, recommendations and goals are
// ordinary columns and rows so later modules (therapy plans, reports) can query them.

/// Why the assessment is done; not a discipline (that's the therapy type).
enum AssessmentType {
  INITIAL
  FOLLOW_UP
  REASSESSMENT
}

/// DRAFT: never published. PUBLISHED: has a published version and can be used.
/// ARCHIVED: kept for history, can't be used for new assessments.
enum AssessmentTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// DRAFT: being edited (at most one per template). PUBLISHED: the version new
/// assessments use (at most one). SUPERSEDED: replaced by a later version, still the
/// form of the assessments filled in with it.
enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

/// DRAFT: editable by its therapist, may be incomplete. COMPLETED: signed, read-only.
/// AMENDED: corrected after completion; each correction is an AssessmentAmendment row.
enum AssessmentStatus {
  DRAFT
  COMPLETED
  AMENDED
}

enum GoalPriority {
  HIGH
  MEDIUM
  LOW
}

model AssessmentTemplate {
  id                 String                   @id @default(uuid()) @db.Uuid
  centerId           String                   @db.Uuid
  /// Fixed once a version is published, since assessments are filtered by it
  therapyTypeId      String                   @db.Uuid
  name               String
  description        String?
  /// The assessment type it's meant for; null means any
  purpose            AssessmentType?
  status             AssessmentTemplateStatus @default(DRAFT)
  /// Number of the newest version, published or draft
  latestVersion      Int                      @default(1)
  /// The version new assessments use; null until first published
  publishedVersionId String?                  @unique @db.Uuid
  createdById        String                   @db.Uuid
  archivedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  center           Center                      @relation(fields: [centerId], references: [id], onDelete: Restrict)
  therapyType      TherapyType                 @relation(fields: [therapyTypeId], references: [id], onDelete: Restrict)
  createdBy        User                        @relation("TemplateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedVersion AssessmentTemplateVersion?  @relation("PublishedVersion", fields: [publishedVersionId], references: [id], onDelete: Restrict)
  versions         AssessmentTemplateVersion[] @relation("TemplateVersions")

  @@unique([centerId, name])
  @@index([centerId, therapyTypeId, status])
}

/// One version of a template's form. Its definition can't change once published.
model AssessmentTemplateVersion {
  id            String                @id @default(uuid()) @db.Uuid
  centerId      String                @db.Uuid
  templateId    String                @db.Uuid
  version       Int
  status        TemplateVersionStatus @default(DRAFT)
  /// { sections: [{ key, title, description?, fields: [...] }] }, see engine.ts
  definition    Json
  createdById   String                @db.Uuid
  publishedById String?               @db.Uuid
  publishedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  center      Center              @relation(fields: [centerId], references: [id], onDelete: Restrict)
  template    AssessmentTemplate  @relation("TemplateVersions", fields: [templateId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("TemplateVersionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  publishedBy User?               @relation("TemplateVersionPublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  publishedOf AssessmentTemplate? @relation("PublishedVersion")
  assessments Assessment[]

  @@unique([templateId, version])
}

/// A clinical assessment of one patient by one therapist. Never hard-deleted once
/// completed; a draft can be discarded by its therapist.
model Assessment {
  id                String           @id @default(uuid()) @db.Uuid
  centerId          String           @db.Uuid
  patientId         String           @db.Uuid
  /// The responsible therapist: the only person who edits, completes and amends it
  therapistId       String           @db.Uuid
  therapyTypeId     String           @db.Uuid
  /// The exact form used; never changes after creation
  templateVersionId String           @db.Uuid
  /// The assessment booking it records, if any; one assessment per appointment
  appointmentId     String?          @unique @db.Uuid
  type              AssessmentType
  /// Center-local date the assessment took place
  assessmentDate    DateTime         @db.Date
  status            AssessmentStatus @default(DRAFT)
  /// Field key → answer, validated against the template version. Unanswered fields are
  /// absent, never stored as empty values, so "not recorded" stays distinguishable.
  answers           Json             @default("{}")

  // Common clinical summary, kept as columns for reporting
  summary                   String?
  keyFindings               String?
  strengths                 String?
  areasOfDifficulty         String?
  clinicalImpression        String?
  followUpRecommendation    String?
  additionalRecommendations String?
  suggestedReviewDate       DateTime? @db.Date

  /// Bumped on every content change; writes must send the revision they started from
  revision      Int       @default(1)
  createdById   String    @db.Uuid
  updatedById   String?   @db.Uuid
  completedById String?   @db.Uuid
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  center          Center                     @relation(fields: [centerId], references: [id], onDelete: Restrict)
  patient         Patient                    @relation(fields: [patientId], references: [id], onDelete: Restrict)
  therapist       Therapist                  @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  therapyType     TherapyType                @relation(fields: [therapyTypeId], references: [id], onDelete: Restrict)
  templateVersion AssessmentTemplateVersion  @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  appointment     Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  createdBy       User                       @relation("AssessmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy       User?                      @relation("AssessmentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  completedBy     User?                      @relation("AssessmentCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  recommendations AssessmentRecommendation[]
  goals           AssessmentGoal[]
  amendments      AssessmentAmendment[]
  /// Therapy plans based on this assessment; they never change it
  therapyPlans    TherapyPlan[]

  @@index([centerId, assessmentDate])
  @@index([centerId, status, assessmentDate])
  @@index([patientId, assessmentDate])
  @@index([therapistId, assessmentDate])
}

/// A suggested service: a clinical suggestion only, never a booking, package or invoice.
model AssessmentRecommendation {
  id               String   @id @default(uuid()) @db.Uuid
  assessmentId     String   @db.Uuid
  therapyTypeId    String   @db.Uuid
  sessionsPerWeek  Int?
  durationMinutes  Int?
  reviewAfterWeeks Int?
  note             String?
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())

  assessment  Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  therapyType TherapyType @relation(fields: [therapyTypeId], references: [id], onDelete: Restrict)

  @@index([assessmentId, displayOrder])
  @@index([therapyTypeId])
}

/// An initial goal the therapist suggests. Not an active treatment goal: the therapy
/// plan module decides which ones to adopt.
model AssessmentGoal {
  id               String        @id @default(uuid()) @db.Uuid
  assessmentId     String        @db.Uuid
  title            String
  description      String?
  priority         GoalPriority?
  targetReviewDate DateTime?     @db.Date
  displayOrder     Int           @default(0)
  createdAt        DateTime      @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, displayOrder])
}

/// One correction of a completed assessment, append-only. `previousContent` is the
/// whole clinical content as it was before this correction (so the first row holds the
/// originally signed record); the assessment itself holds the current content.
model AssessmentAmendment {
  id               String   @id @default(uuid()) @db.Uuid
  centerId         String   @db.Uuid
  assessmentId     String   @db.Uuid
  /// 1 for the first correction
  number           Int
  reason           String
  /// Labels of what changed (field labels, "Recommendations", …), never values
  changedFields    Json
  previousContent  Json
  /// The assessment's revision before this correction
  previousRevision Int
  amendedById      String   @db.Uuid
  amendedAt        DateTime @default(now())

  center     Center     @relation(fields: [centerId], references: [id], onDelete: Restrict)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  amendedBy  User       @relation("AssessmentAmendedBy", fields: [amendedById], references: [id], onDelete: Restrict)

  @@unique([assessmentId, number])
}

// ── Therapy plans ───────────────────────────────────────────────────────────
// A therapy plan is the intended treatment for one patient in one service: who leads it,
// how often sessions are recommended, and the goals they work towards. It never books,
// sells, bills or documents a session; appointments, packages, invoices and session
// notes are their own records and may point at a plan later.
//
// Drafts are edited freely. From activation on, every clinically significant change
// appends a TherapyPlanRevision (who, when, why, the values before and after), progress
// is an append-only list of observations per goal, and reviews are kept with a snapshot
// of the goals as they stood. Triggers in the therapy plans migration refuse changes to
// closed plans and to those append-only histories.

/// DRAFT: being written. ACTIVE: the treatment in force. PAUSED: on hold, with a reason.
/// COMPLETED / DISCONTINUED: closed for good, read-only.
enum TherapyPlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  DISCONTINUED
}

/// A calendar period, for recommended frequency and review intervals.
enum PlanPeriodUnit {
  DAY
  WEEK
  MONTH
}

enum TherapyGoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  ON_HOLD
  DISCONTINUED
}

/// How a goal is measured. Only NARRATIVE goals have no numbers; the others keep
/// numeric baseline, target and progress values, checked by src/therapy-plans/measurement.ts.
enum GoalMeasurementType {
  NARRATIVE
  PERCENTAGE
  COUNT
  DURATION
  FREQUENCY
  RATING_SCALE
  CUSTOM
}

/// A therapist's overall judgement at a review: a documentation label, never computed.
enum ReviewOverallProgress {
  SIGNIFICANT
  MODERATE
  MINIMAL
  NONE
  REGRESSION
  NOT_ENOUGH_INFORMATION
}

/// What a review recommends. Recording it changes nothing; staff act on it explicitly.
enum ReviewRecommendation {
  CONTINUE
  MODIFY
  INCREASE_FREQUENCY
  DECREASE_FREQUENCY
  PAUSE
  COMPLETE
  REFER_FOR_ASSESSMENT
}

/// What a plan history entry records.
enum TherapyPlanEvent {
  ACTIVATED
  PAUSED
  RESUMED
  COMPLETED
  DISCONTINUED
  /// Plan details (frequency, duration, dates, focus, …) changed after activation
  REVISED
  THERAPIST_REASSIGNED
  GOAL_ADDED
  GOAL_UPDATED
}

/// Center-defined goal groupings, optionally for one therapy type. Kept forever once
/// used (goals refer to them); deactivated ones can't be chosen for new goals.
model TherapyGoalCategory {
  id            String   @id @default(uuid()) @db.Uuid
  centerId      String   @db.Uuid
  /// Null: offered for every therapy type
  therapyTypeId String?  @db.Uuid
  name          String
  description   String?
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  center      Center            @relation(fields: [centerId], references: [id], onDelete: Restrict)
  therapyType TherapyType?      @relation(fields: [therapyTypeId], references: [id], onDelete: Restrict)
  goals       TherapyPlanGoal[]

  // Names are unique per center and therapy type (case-insensitively), by an index in
  // the migration.
  @@index([centerId, isActive, displayOrder])
}

model TherapyPlan {
  id                     String            @id @default(uuid()) @db.Uuid
  centerId               String            @db.Uuid
  /// Generated per center from CenterSequence, e.g. TP-0007. Never reused.
  code                   String
  patientId              String            @db.Uuid
  therapyTypeId          String            @db.Uuid
  /// The responsible therapist: the one who edits, activates, reviews and revises it
  therapistId            String            @db.Uuid
  /// The completed assessment it was based on, if any. Never changed by the plan.
  sourceAssessmentId     String?           @db.Uuid
  title                  String
  treatmentFocus         String?
  clinicalNotes          String?
  /// Recommended frequency: sessionsPerPeriod per frequencyUnit, e.g. 3 per WEEK.
  /// A recommendation only; appointments are booked separately.
  sessionsPerPeriod      Int?
  frequencyUnit          PlanPeriodUnit?
  durationMinutes        Int?
  reviewIntervalValue    Int?
  reviewIntervalUnit     PlanPeriodUnit?
  additionalInstructions String?
  /// Center-local dates
  startDate              DateTime          @db.Date
  targetEndDate          DateTime?         @db.Date
  /// A clinical follow-up target, never a booking
  nextReviewDate         DateTime?         @db.Date
  status                 TherapyPlanStatus @default(DRAFT)
  activatedAt            DateTime?
  activatedById          String?           @db.Uuid
  pausedAt               DateTime?
  /// Why it was paused or discontinued (the latest such change)
  statusReason           String?
  completedAt            DateTime?
  completedById          String?           @db.Uuid
  completionSummary      String?
  discontinuedAt         DateTime?
  discontinuedById       String?           @db.Uuid
  /// Bumped on every change to the plan row; writes must send the revision they started from
  revision               Int               @default(1)
  createdById            String            @db.Uuid
  updatedById            String?           @db.Uuid
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  center           Center                @relation(fields: [centerId], references: [id], onDelete: Restrict)
  patient          Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  therapyType      TherapyType           @relation(fields: [therapyTypeId], references: [id], onDelete: Restrict)
  therapist        Therapist             @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  sourceAssessment Assessment?           @relation(fields: [sourceAssessmentId], references: [id], onDelete: Restrict)
  /// Packages bought for this treatment; they never change the plan
  packages         PackageEnrollment[]
  activatedBy      User?                 @relation("PlanActivatedBy", fields: [activatedById], references: [id], onDelete: Restrict)
  completedBy      User?                 @relation("PlanCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  discontinuedBy   User?                 @relation("PlanDiscontinuedBy", fields: [discontinuedById], references: [id], onDelete: Restrict)
  createdBy        User                  @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        User?                 @relation("PlanUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  goals            TherapyPlanGoal[]
  progress         TherapyGoalProgress[]
  reviews          TherapyPlanReview[]
  revisions        TherapyPlanRevision[]

  // At most one ACTIVE or PAUSED plan per patient and therapy type: a partial unique
  // index in the migration.
  @@unique([centerId, code])
  @@index([centerId, status, nextReviewDate])
  @@index([centerId, createdAt])
  @@index([patientId, status])
  @@index([therapistId, status])
  @@index([therapyTypeId])
  @@index([sourceAssessmentId])
}

/// One treatment goal. Never deleted once the plan is active: goals that stop being
/// worked on are DISCONTINUED and stay in the record.
model TherapyPlanGoal {
  id                     String              @id @default(uuid()) @db.Uuid
  centerId               String              @db.Uuid
  therapyPlanId          String              @db.Uuid
  /// The assessment goal it was copied from, for traceability. Not a foreign key:
  /// amending an assessment replaces its goal rows, and the plan keeps its own copy.
  sourceAssessmentGoalId String?             @db.Uuid
  categoryId             String?             @db.Uuid
  title                  String
  description            String?
  priority               GoalPriority?
  measurementType        GoalMeasurementType @default(NARRATIVE)
  /// { unit?, scaleMin?, scaleMax? } as measurement.ts allows for the type
  measurementConfig      Json?
  /// Narrative baseline/target, or a note alongside a numeric value
  baselineText           String?
  baselineValue          Float?
  targetText             String?
  targetValue            Float?
  targetDate             DateTime?           @db.Date
  status                 TherapyGoalStatus   @default(NOT_STARTED)
  statusChangedAt        DateTime?
  statusChangedById      String?             @db.Uuid
  notes                  String?
  displayOrder           Int                 @default(0)
  createdById            String              @db.Uuid
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  center          Center                @relation(fields: [centerId], references: [id], onDelete: Restrict)
  therapyPlan     TherapyPlan           @relation(fields: [therapyPlanId], references: [id], onDelete: Restrict)
  category        TherapyGoalCategory?  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  statusChangedBy User?                 @relation("GoalStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: Restrict)
  createdBy       User                  @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  progress        TherapyGoalProgress[]

  @@index([therapyPlanId, displayOrder])
  @@index([categoryId])
}

/// One observation of a goal, append-only. A correction is a new entry pointing at the
/// one it replaces (correctsId), so the original stays readable.
model TherapyGoalProgress {
  id               String             @id @default(uuid()) @db.Uuid
  centerId         String             @db.Uuid
  therapyPlanId    String             @db.Uuid
  goalId           String             @db.Uuid
  /// Center-local date of the observation
  observationDate  DateTime           @db.Date
  /// The goal's status as the clinician judged it at this observation, if recorded
  goalStatus       TherapyGoalStatus?
  /// Only for measured goals, in the goal's unit; checked against its configuration
  measuredValue    Float?
  observation      String?
  correctsId       String?            @unique @db.Uuid
  correctionReason String?
  recordedById     String             @db.Uuid
  createdAt        DateTime           @default(now())

  center      Center               @relation(fields: [centerId], references: [id], onDelete: Restrict)
  therapyPlan TherapyPlan          @relation(fields: [therapyPlanId], references: [id], onDelete: Restrict)
  goal        TherapyPlanGoal      @relation(fields: [goalId], references: [id], onDelete: Restrict)
  corrects    TherapyGoalProgress? @relation("ProgressCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  correctedBy TherapyGoalProgress? @relation("ProgressCorrection")
  recordedBy  User                 @relation("ProgressRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([goalId, observationDate])
  @@index([therapyPlanId, observationDate])
}

/// A periodic clinical review, confirmed when it's saved. Corrections keep the earlier
/// content in TherapyPlanReviewAmendment.
model TherapyPlanReview {
  id              String                @id @default(uuid()) @db.Uuid
  centerId        String                @db.Uuid
  therapyPlanId   String                @db.Uuid
  /// 1 for the plan's first review
  number          Int
  reviewDate      DateTime              @db.Date
  /// The reviewing therapist's profile and signed-in account
  therapistId     String                @db.Uuid
  reviewedById    String                @db.Uuid
  overallProgress ReviewOverallProgress
  recommendation  ReviewRecommendation
  observations    String?
  goalSummary     String?
  notes           String?
  nextReviewDate  DateTime?             @db.Date
  /// The goals (status, baseline, target, latest progress) as they stood at the review
  goalSnapshot    Json
  /// Plan frequency, duration and status at the review
  planSnapshot    Json
  completedAt     DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  center      Center                       @relation(fields: [centerId], references: [id], onDelete: Restrict)
  therapyPlan TherapyPlan                  @relation(fields: [therapyPlanId], references: [id], onDelete: Restrict)
  therapist   Therapist                    @relation(fields: [therapistId], references: [id], onDelete: Restrict)
  reviewedBy  User                         @relation("PlanReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  amendments  TherapyPlanReviewAmendment[]

  @@unique([therapyPlanId, number])
}

/// One correction of a review, append-only; previousContent is the review before it.
model TherapyPlanReviewAmendment {
  id              String   @id @default(uuid()) @db.Uuid
  centerId        String   @db.Uuid
  reviewId        String   @db.Uuid
  number          Int
  reason          String
  /// Labels of what changed, never values
  changedFields   Json
  previousContent Json
  amendedById     String   @db.Uuid
  amendedAt       DateTime @default(now())

  center    Center            @relation(fields: [centerId], references: [id], onDelete: Restrict)
  review    TherapyPlanReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  amendedBy User              @relation("ReviewAmendedBy", fields: [amendedById], references: [id], onDelete: Restrict)

  @@unique([reviewId, number])
}

/// The plan's history from activation on, append-only: status changes, revisions,
/// reassignments and goal changes, each with the values before and after.
model TherapyPlanRevision {
  id               String           @id @default(uuid()) @db.Uuid
  centerId         String           @db.Uuid
  therapyPlanId    String           @db.Uuid
  /// 1 for the plan's first entry
  number           Int
  event            TherapyPlanEvent
  /// Labels of what changed, e.g. "Frequency", never values
  changedFields    Json             @default("[]")
  previousSnapshot Json?
  newSnapshot      Json?
  reason           String?
  /// The goal an event is about, for GOAL_ADDED / GOAL_UPDATED
  goalId           String?          @db.Uuid
  /// The review that led to this change, when there was one
  reviewId         String?          @db.Uuid
  revisedById      String           @db.Uuid
  revisedAt        DateTime         @default(now())

  center      Center      @relation(fields: [centerId], references: [id], onDelete: Restrict)
  therapyPlan TherapyPlan @relation(fields: [therapyPlanId], references: [id], onDelete: Restrict)
  revisedBy   User        @relation("PlanRevisedBy", fields: [revisedById], references: [id], onDelete: Restrict)

  @@unique([therapyPlanId, number])
}

// ── Packages ────────────────────────────────────────────────────────────────
// A package is a commercial offering: a number of sessions, valid for a period, at a
// price, usable for one or more therapy types (one shared pool of sessions). It never
// books appointments, recommends treatment (that's a therapy plan) or takes payment
// (that's billing).
//
// An enrollment is one patient's purchase of a package. It copies the package's terms
// when it's made (sessions, validity, rules, price, discount), so later catalog changes
// never touch it; a trigger in the packages migration refuses changes to those terms.
// Buying again is a new enrollment, never a top-up of an old one.
//
// Session entitlement is tracked by two append-only records, never by editing a number:
// - PackageSessionLedger: credits (the initial allocation, bonuses, corrections) and
//   debits (consumed sessions, manual debits), each with who, when and why. A reversal
//   is a new entry pointing at the consumption it undoes.
// - PackageSessionReservation: a session held for one booked appointment. It ends as
//   CONSUMED (the session was charged) or RELEASED (it wasn't).
// The enrollment's totalSessions, consumedSessions and reservedSessions are a
// projection of those rows kept by triggers in the migration, and a CHECK keeps
// consumed + reserved ≤ total, so concurrent bookings can't overdraw a package.

/// A period length, for package validity and usage limits.
enum PackagePeriodUnit {
  DAY
  WEEK
  /// Calendar months (see packages/rules.ts for days a month lacks)
  MONTH
}

/// When an enrollment's validity starts.
enum PackageActivationPolicy {
  /// The day it's enrolled
  ENROLLMENT_DATE
  /// A date staff choose when enrolling, past or future
  FIXED_DATE
  /// The day of the first session it pays for; PENDING until then
  FIRST_SESSION
}

enum PackageDiscountType {
  NONE
  /// An amount off the catalog price
  FIXED
  /// A percentage off the catalog price
  PERCENTAGE
  /// A different agreed price, set directly
  PRICE_OVERRIDE
}

/// The stored lifecycle state. EXPIRED and EXHAUSTED aren't stored: the API derives
/// them from the dates and balances on every read (packages/rules.ts), so they can
/// never be out of date.
enum PackageEnrollmentState {
  /// Validity hasn't started: first-session activation that hasn't happened yet
  PENDING
  ACTIVE
  CANCELLED
}

enum PackageLedgerMovement {
  INITIAL_ALLOCATION
  /// A courtesy session, e.g. a goodwill bonus
  BONUS_CREDIT
  /// A correction in the patient's favour
  MANUAL_CREDIT
  /// A correction against the balance
  MANUAL_DEBIT
  /// One session charged for an appointment
  SESSION_CONSUMPTION
  /// Undoes one SESSION_CONSUMPTION (reversesId)
  CONSUMPTION_REVERSAL
}

/// Why a session was charged.
enum PackageChargeReason {
  COMPLETED
  NO_SHOW
  LATE_CANCELLATION
}

enum PackageReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum PackageReleaseReason {
  /// Cancelled in time, or late where the package doesn't charge late cancellations
  APPOINTMENT_CANCELLED
  /// A no-show the package doesn't charge
  NO_SHOW_NOT_CHARGED
  /// Taken off the appointment by staff, or moved to another package
  REMOVED
  ENROLLMENT_CANCELLED
}

model TherapyPackage {
  id                     String                  @id @default(uuid()) @db.Uuid
  centerId               String                  @db.Uuid
  /// Unique per center, stored upper-cased, e.g. PKG-0004 or OT-MONTHLY
  code                   String
  name                   String
  description            String?
  /// Sessions included; one shared pool for every eligible therapy type
  sessionCount           Int
  /// A suggestion for booking; appointments keep their own length
  defaultDurationMinutes Int?
  price                  Decimal                 @db.Decimal(12, 2)
  validityValue          Int
  validityUnit           PackagePeriodUnit
  /// Preselected when enrolling
  activationPolicy       PackageActivationPolicy @default(ENROLLMENT_DATE)
  /// Optional: at most usageLimitCount sessions per usageLimitPeriod. Off when null.
  usageLimitCount        Int?
  usageLimitPeriod       PackagePeriodUnit?
  /// Assessments can use it too; by default only therapy sessions do
  coversAssessments      Boolean                 @default(false)
  /// Whether a no-show uses up a session
  chargeNoShow           Boolean                 @default(false)
  /// Whether a cancellation inside the center's cutoff uses up a session
  chargeLateCancellation Boolean                 @default(false)
  /// Inactive packages can't be newly enrolled in; existing enrollments are unaffected
  isActive               Boolean                 @default(true)
  displayOrder           Int                     @default(0)
  createdById            String                  @db.Uuid
  updatedById            String?                 @db.Uuid
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  center       Center                       @relation(fields: [centerId], references: [id], onDelete: Restrict)
  createdBy    User                         @relation("PackageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?                        @relation("PackageUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  therapyTypes PackageEligibleTherapyType[]
  enrollments  PackageEnrollment[]

  @@unique([centerId, code])
  @@index([centerId, isActive, displayOrder])
}

/// A therapy type a package can be used for. Removed with the package (only unused
/// packages can be deleted); enrollments keep their own copy.
model PackageEligibleTherapyType {
  packageId     String @db.Uuid
  therapyTypeId String @db.Uuid

  package     TherapyPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  therapyType TherapyType    @relation(fields: [therapyTypeId], references: [id], onDelete: Restrict)

  @@id([packageId, therapyTypeId])
  @@index([therapyTypeId])
}

/// One patient's purchase of a package. Never deleted; cancelling keeps the row and
/// its history. Its price is what was agreed, not what was paid: payment is billing's.
model PackageEnrollment {
  id            String  @id @default(uuid()) @db.Uuid
  centerId      String  @db.Uuid
  /// Generated per center from CenterSequence, e.g. PE-0012. The purchase reference
  /// billing will invoice against.
  code          String
  patientId     String  @db.Uuid
  /// The catalog package it was bought from, for reporting. Its current terms don't apply.
  packageId     String  @db.Uuid
  /// The treatment it was bought for, if any (same patient). Never changes the plan.
  therapyPlanId String? @db.Uuid
  /// The enrollment this one renews; balances are never carried over
  renewedFromId String? @db.Uuid
  /// Client-generated key: the same request sent twice creates one enrollment
  requestId     String? @db.Uuid

  // The package's terms when enrolled; fixed from then on.
  packageName            String
  packageCode            String
  /// Name, code, description and therapy types (id, name, code) as they were
  packageSnapshot        Json
  /// Sessions purchased: the initial allocation
  sessionCount           Int
  defaultDurationMinutes Int?
  validityValue          Int
  validityUnit           PackagePeriodUnit
  activationPolicy       PackageActivationPolicy
  usageLimitCount        Int?
  usageLimitPeriod       PackagePeriodUnit?
  coversAssessments      Boolean
  chargeNoShow           Boolean
  chargeLateCancellation Boolean

  // Agreed price. Money is NUMERIC, never floating point.
  currency      String
  catalogPrice  Decimal             @db.Decimal(12, 2)
  discountType  PackageDiscountType @default(NONE)
  /// The amount (FIXED) or percentage (PERCENTAGE) given; null otherwise
  discountValue Decimal?            @db.Decimal(12, 2)
  finalPrice    Decimal             @db.Decimal(12, 2)

  /// Center-local dates, both included. Null until a first-session enrollment
  /// activates; fixed once set.
  startDate          DateTime?              @db.Date
  endDate            DateTime?              @db.Date
  /// The end date was chosen by staff rather than computed from the validity
  customEndDate      Boolean                @default(false)
  state              PackageEnrollmentState
  activatedAt        DateTime?
  notes              String?
  cancelledAt        DateTime?
  cancelledById      String?                @db.Uuid
  cancellationReason String?

  // Kept by triggers from the ledger and reservations; never written by the API.
  /// Purchased plus credits minus manual debits
  totalSessions    Int @default(0)
  /// Charged sessions, net of reversals
  consumedSessions Int @default(0)
  /// Sessions held by booked appointments
  reservedSessions Int @default(0)

  createdById String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  center       Center                         @relation(fields: [centerId], references: [id], onDelete: Restrict)
  patient      Patient                        @relation(fields: [patientId], references: [id], onDelete: Restrict)
  package      TherapyPackage                 @relation(fields: [packageId], references: [id], onDelete: Restrict)
  therapyPlan  TherapyPlan?                   @relation(fields: [therapyPlanId], references: [id], onDelete: Restrict)
  renewedFrom  PackageEnrollment?             @relation("EnrollmentRenewal", fields: [renewedFromId], references: [id], onDelete: Restrict)
  renewals     PackageEnrollment[]            @relation("EnrollmentRenewal")
  createdBy    User                           @relation("EnrollmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy  User?                          @relation("EnrollmentCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  therapyTypes PackageEnrollmentTherapyType[]
  ledger       PackageSessionLedger[]
  reservations PackageSessionReservation[]
  appointments Appointment[]

  @@unique([centerId, code])
  @@unique([centerId, requestId])
  @@index([centerId, createdAt])
  @@index([centerId, state, endDate])
  @@index([patientId, createdAt])
  @@index([packageId])
  @@index([therapyPlanId])
}

/// A therapy type an enrollment can be used for, copied from its package.
model PackageEnrollmentTherapyType {
  enrollmentId  String @db.Uuid
  therapyTypeId String @db.Uuid

  enrollment  PackageEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  therapyType TherapyType       @relation(fields: [therapyTypeId], references: [id], onDelete: Restrict)

  @@id([enrollmentId, therapyTypeId])
  @@index([therapyTypeId])
}

/// One credit or debit of an enrollment's sessions, append-only. Credits are positive,
/// debits negative. A session is consumed at most once per appointment and a
/// consumption reversed at most once (unique indexes in the migration).
model PackageSessionLedger {
  id            String                @id @default(uuid()) @db.Uuid
  centerId      String                @db.Uuid
  enrollmentId  String                @db.Uuid
  movement      PackageLedgerMovement
  quantity      Int
  /// The appointment charged, for SESSION_CONSUMPTION
  appointmentId String?               @db.Uuid
  /// The reservation the consumption came from
  reservationId String?               @db.Uuid
  /// The SESSION_CONSUMPTION a CONSUMPTION_REVERSAL undoes
  reversesId    String?               @unique @db.Uuid
  chargeReason  PackageChargeReason?
  /// Why, for manual movements and reversals
  reason        String?
  /// Client-generated key: the same adjustment sent twice is recorded once
  requestId     String?               @db.Uuid
  createdById   String                @db.Uuid
  createdAt     DateTime              @default(now())

  center      Center                     @relation(fields: [centerId], references: [id], onDelete: Restrict)
  enrollment  PackageEnrollment          @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  appointment Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  reservation PackageSessionReservation? @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  reverses    PackageSessionLedger?      @relation("LedgerReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy  PackageSessionLedger?      @relation("LedgerReversal")
  createdBy   User                       @relation("LedgerCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, requestId])
  @@index([enrollmentId, createdAt])
  @@index([appointmentId])
}

/// A session held for one booked appointment, until it's charged (CONSUMED) or not
/// (RELEASED). At most one ACTIVE reservation per appointment (migration). Ended
/// reservations never change.
model PackageSessionReservation {
  id            String                   @id @default(uuid()) @db.Uuid
  centerId      String                   @db.Uuid
  enrollmentId  String                   @db.Uuid
  appointmentId String                   @db.Uuid
  quantity      Int                      @default(1)
  status        PackageReservationStatus @default(ACTIVE)
  /// The appointment's center-local date, kept in step when it's rescheduled; used for
  /// validity and usage limits
  sessionDate   DateTime                 @db.Date
  createdById   String                   @db.Uuid
  createdAt     DateTime                 @default(now())
  releasedAt    DateTime?
  releasedById  String?                  @db.Uuid
  releaseReason PackageReleaseReason?
  consumedAt    DateTime?

  center      Center                 @relation(fields: [centerId], references: [id], onDelete: Restrict)
  enrollment  PackageEnrollment      @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  appointment Appointment            @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  createdBy   User                   @relation("ReservationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  releasedBy  User?                  @relation("ReservationReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
  movements   PackageSessionLedger[]

  @@index([enrollmentId, status, sessionDate])
  @@index([appointmentId])
}
