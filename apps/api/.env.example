# Special characters in the password must be URL-encoded (@ -> %40)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# A separate, disposable database for `npm run test:e2e` (the tests delete all its data).
# Apply migrations to it first: DATABASE_URL=$TEST_DATABASE_URL npx prisma migrate deploy
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/carezino_test?schema=public"

# Public URL of the web app, used for links in password-reset and invitation emails.
WEB_APP_URL="http://localhost:3000"

# Public self-service signup at /register. Off by default: platform administrators
# (super admins) register centers from /admin. Create one with:
#   PLATFORM_ADMIN_USERNAME=admin PLATFORM_ADMIN_PASSWORD='…' npm run platform:create-admin
# (add --reset-password to change an existing admin's password)
PUBLIC_REGISTRATION_ENABLED=false

# Cookies are marked Secure in production by default. Set to true whenever the app is
# served over HTTPS.
# COOKIE_SECURE=true

# Session lifetimes. "Remember me" sessions use SESSION_REMEMBER_DAYS.
# SESSION_TTL_HOURS=12
# SESSION_REMEMBER_DAYS=30
# PASSWORD_RESET_TTL_MINUTES=30
# INVITATION_TTL_DAYS=7

# Which proxies to trust for the client IP (Express "trust proxy"). The web app proxies
# /api from the same host, so the default is loopback.
# TRUST_PROXY=loopback

# Rate limits (in-memory, per API process).
# API_RATE_LIMIT_PER_MINUTE=300
# AUTH_RATE_LIMIT_PER_MINUTE=20
# AUTH_RATE_LIMIT_PER_ACCOUNT=10

# SMTP for password-reset and invitation emails. Without SMTP_HOST no email is sent:
# in development the message and its link are printed to the API console instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Carezino <no-reply@example.com>"
